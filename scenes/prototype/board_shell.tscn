[gd_scene format=3]

[node name="BoardShell" type="PanelContainer"]
custom_minimum_size = Vector2(640, 560)
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 1

[node name="BoardMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="BoardColumn" type="VBoxContainer" parent="BoardMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BoardTitle" type="Label" parent="BoardMargin/BoardColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "24 × 9 灰盒主棋盘（固定 1-based 坐标）"

[node name="OverviewStrip" type="Label" parent="BoardMargin/BoardColumn"]
layout_mode = 2
text = "导航概览：等待 PlayerView"
autowrap_mode = 2

[node name="BoardScroll" type="ScrollContainer" parent="BoardMargin/BoardColumn"]
custom_minimum_size = Vector2(0, 390)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 1

[node name="BoardGrid" type="GridContainer" parent="BoardMargin/BoardColumn/BoardScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2
columns = 9


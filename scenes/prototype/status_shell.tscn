[gd_scene format=3]

[node name="StatusShell" type="ScrollContainer"]
custom_minimum_size = Vector2(300, 360)
horizontal_scroll_mode = 0
size_flags_vertical = 3
mouse_filter = 1

[node name="StatusMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="StatusColumn" type="VBoxContainer" parent="StatusMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="StatusTitle" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "战局信息（仅玩家可见内容）"

[node name="TurnAndSelection" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "行动与选择：等待初始化"
autowrap_mode = 2

[node name="WallStatus" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "城墙：等待初始化"

[node name="FlagStatus" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "三旗：等待初始化"
autowrap_mode = 2

[node name="PieceStatus" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "棋子：无"
autowrap_mode = 2

[node name="ModeStatus" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "模式：普通移动"
autowrap_mode = 2

[node name="ActionMode" type="GridContainer" parent="StatusMargin/StatusColumn"]
layout_mode = 2
columns = 2

[node name="MoveButton" type="Button" parent="StatusMargin/StatusColumn/ActionMode"]
custom_minimum_size = Vector2(98, 42)
layout_mode = 2
text = "普通移动"

[node name="BombardButton" type="Button" parent="StatusMargin/StatusColumn/ActionMode"]
custom_minimum_size = Vector2(98, 42)
layout_mode = 2
text = "区域炮击"

[node name="ResurrectButton" type="Button" parent="StatusMargin/StatusColumn/ActionMode"]
custom_minimum_size = Vector2(98, 42)
layout_mode = 2
text = "献祭复活"

[node name="PassButton" type="Button" parent="StatusMargin/StatusColumn/ActionMode"]
custom_minimum_size = Vector2(98, 42)
layout_mode = 2
text = "主动跳过"

[node name="AiStepButton" type="Button" parent="StatusMargin/StatusColumn/ActionMode"]
visible = false
custom_minimum_size = Vector2(145, 44)
layout_mode = 2
text = "AI 自动行动"

[node name="MessageValue" type="Label" parent="StatusMargin/StatusColumn"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.38, 1)
text = "提示：左键选择棋子；选中时右键取消，未选中时右键添加圆、叉或方形标注。"
autowrap_mode = 2

[node name="CasualtyTitle" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "阵亡棋子"

[node name="CasualtyGrid" type="GridContainer" parent="StatusMargin/StatusColumn"]
layout_mode = 2
theme_override_constants/h_separation = 8
columns = 2

[node name="RedCasualties" type="Label" parent="StatusMargin/StatusColumn/CasualtyGrid"]
custom_minimum_size = Vector2(150, 50)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.42, 0.38, 1)
text = "红方：无"
autowrap_mode = 2

[node name="BlackCasualties" type="Label" parent="StatusMargin/StatusColumn/CasualtyGrid"]
custom_minimum_size = Vector2(150, 50)
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.82, 0.88, 1)
text = "黑方：无"
autowrap_mode = 2

[node name="Separator" type="HSeparator" parent="StatusMargin/StatusColumn"]
layout_mode = 2

[node name="EventTitle" type="Label" parent="StatusMargin/StatusColumn"]
layout_mode = 2
text = "玩家可见事件"

[node name="EventLog" type="RichTextLabel" parent="StatusMargin/StatusColumn"]
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
size_flags_vertical = 3
text = "尚无玩家可见事件。"
scroll_active = true
scroll_following = true

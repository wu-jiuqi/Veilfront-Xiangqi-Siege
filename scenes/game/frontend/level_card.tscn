[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/game/frontend/level_card.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/game/ui/ui_motion_button_secondary.tscn" id="2_button"]

[node name="LevelCard" type="Control"]
custom_minimum_size = Vector2(116, 92)
layout_mode = 3
anchors_preset = 0
script = ExtResource("1_script")

[node name="StateTexture" type="TextureRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="NodeButton" parent="." instance=ExtResource("2_button")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
text = ""

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
alignment = 1

[node name="CodeLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"NumericText"
text = "T0"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "可进入"
horizontal_alignment = 1

[connection signal="pressed" from="NodeButton" to="." method="_on_pressed"]
[connection signal="focus_entered" from="NodeButton" to="." method="_on_focus_entered"]
[connection signal="focus_exited" from="NodeButton" to="." method="_on_focus_exited"]
[connection signal="mouse_entered" from="NodeButton" to="." method="_on_mouse_entered"]
[connection signal="mouse_exited" from="NodeButton" to="." method="_on_mouse_exited"]

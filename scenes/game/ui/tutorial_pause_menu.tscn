[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/game/tutorial/tutorial_pause_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/game/ui/themes/veilfront_ui_theme_v2.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/game/ui/ui_motion_button_confirm.tscn" id="3_confirm"]
[ext_resource type="PackedScene" path="res://scenes/game/ui/ui_motion_button_secondary.tscn" id="4_secondary"]
[ext_resource type="PackedScene" path="res://scenes/game/ui/ui_motion_button_danger.tscn" id="5_danger"]

[node name="TutorialPauseMenu" type="Control"]
process_mode = 3
visible = false
z_index = 100
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="InputBlocker" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.005, 0.007, 0.006, 0.88)

[node name="DialogCenter" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="DialogCanvas" type="PanelContainer" parent="DialogCenter"]
custom_minimum_size = Vector2(560, 510)
layout_mode = 2
mouse_filter = 0
theme_type_variation = &"PauseOverlaySurface"

[node name="Content" type="VBoxContainer" parent="DialogCenter/DialogCanvas"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="DialogCenter/DialogCanvas/Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="DialogCenter/DialogCanvas/Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ScreenTitle"
text = "教学暂停"

[node name="CloseButton" parent="DialogCenter/DialogCanvas/Content/Header" instance=ExtResource("4_secondary")]
custom_minimum_size = Vector2(48, 44)
layout_mode = 2
theme_type_variation = &"CompactButton"
text = "×"
tooltip_text = "继续教学"

[node name="Subtitle" type="Label" parent="DialogCenter/DialogCanvas/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "当前章节进度已保留 · 按 ESC 继续"

[node name="Separator" type="HSeparator" parent="DialogCenter/DialogCanvas/Content"]
layout_mode = 2

[node name="ActionColumn" type="VBoxContainer" parent="DialogCenter/DialogCanvas/Content"]
layout_mode = 2
size_flags_vertical = 3
alignment = 1
theme_override_constants/separation = 10

[node name="ContinueButton" parent="DialogCenter/DialogCanvas/Content/ActionColumn" instance=ExtResource("3_confirm")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
focus_neighbor_top = NodePath("../ExitTutorialButton")
focus_neighbor_bottom = NodePath("../RestartChapterButton")
text = "继续教学"

[node name="RestartChapterButton" parent="DialogCenter/DialogCanvas/Content/ActionColumn" instance=ExtResource("4_secondary")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
focus_neighbor_top = NodePath("../ContinueButton")
focus_neighbor_bottom = NodePath("../CodexButton")
text = "重新开始本章"

[node name="CodexButton" parent="DialogCenter/DialogCanvas/Content/ActionColumn" instance=ExtResource("4_secondary")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
focus_neighbor_top = NodePath("../RestartChapterButton")
focus_neighbor_bottom = NodePath("../ExitTutorialButton")
text = "打开战阵图鉴"

[node name="ExitTutorialButton" parent="DialogCenter/DialogCanvas/Content/ActionColumn" instance=ExtResource("5_danger")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
focus_neighbor_top = NodePath("../CodexButton")
focus_neighbor_bottom = NodePath("../ContinueButton")
text = "退出教学"

[node name="FooterHint" type="Label" parent="DialogCenter/DialogCanvas/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "键盘方向键切换 · Enter 确认"
horizontal_alignment = 1

[connection signal="pressed" from="DialogCenter/DialogCanvas/Content/Header/CloseButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="DialogCenter/DialogCanvas/Content/ActionColumn/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="DialogCenter/DialogCanvas/Content/ActionColumn/RestartChapterButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="DialogCenter/DialogCanvas/Content/ActionColumn/CodexButton" to="." method="_on_codex_pressed"]
[connection signal="pressed" from="DialogCenter/DialogCanvas/Content/ActionColumn/ExitTutorialButton" to="." method="_on_exit_pressed"]

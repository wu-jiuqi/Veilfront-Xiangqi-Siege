[sub_resource type="Shader" id="ShaderCircularPortrait"]
code = "shader_type canvas_item;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	float distance_from_center = length(UV - vec2(0.5));
	float circle_alpha = 1.0 - smoothstep(0.46, 0.5, distance_from_center);
	COLOR = vec4(source.rgb, source.a * circle_alpha);
}
"


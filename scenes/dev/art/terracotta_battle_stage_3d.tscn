[sub_resource type="Shader" id="Shader_chroma_key"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, blend_mix, depth_draw_opaque;\n\nuniform sampler2D albedo_texture : source_color, filter_linear_mipmap_anisotropic;\nuniform float alpha_scale : hint_range(0.0, 1.0) = 1.0;\n\nvoid fragment() {\n\tvec4 sample_color = texture(albedo_texture, UV);\n\tfloat lightest = max(sample_color.r, max(sample_color.g, sample_color.b));\n\tfloat darkest = min(sample_color.r, min(sample_color.g, sample_color.b));\n\tfloat neutral_light = smoothstep(0.72, 0.88, lightest) * (1.0 - smoothstep(0.035, 0.12, lightest - darkest));\n\tALBEDO = sample_color.rgb;\n\tROUGHNESS = 1.0;\n\tALPHA = sample_color.a * (1.0 - neutral_light) * alpha_scale;\n}\n"


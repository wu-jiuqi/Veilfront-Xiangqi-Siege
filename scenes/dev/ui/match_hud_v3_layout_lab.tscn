[sub_resource type="Shader" id="ShaderCircularPortrait"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat distance_from_center = length(UV - vec2(0.5));\n\tfloat circle_alpha = 1.0 - smoothstep(0.46, 0.5, distance_from_center);\n\tCOLOR = vec4(source.rgb, source.a * circle_alpha);\n}\n"


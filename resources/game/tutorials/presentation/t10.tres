[gd_resource type="Resource" script_class="TutorialPresentationTrack" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/game/tutorial/tutorial_presentation_track.gd" id="1"]

[resource]
script = ExtResource("1")
track_id = "tutorial-t10-presentation-v1"
level_id = "T10"
title = "第一面战旗"
subtitle = "综合考核"
goal = "在八个己方行动内发现目标旗、处理路径威胁并完成占领。"
tags = PackedStringArray("无直接箭头", "组合机制", "固定脚本", "八行动限制")
steps = Array[Dictionary]([{"id":"t10_scout","type":"move","actor":"re10","target":[5,12],"title":"目标：建立侦察视野","prompt":"没有箭头提示。选择能够让你发现战区目标的行动。","success":"相的扩展视野发现目标旗。"},{"id":"t10_contact","type":"move","actor":"rr10","target":[2,15],"title":"目标：处理未知路径接触","prompt":"为占领路线建立车路径视野。留意路径中可能存在未显形目标。","success":"车在（2,12）接触并吃掉隐身马后停点。"},{"id":"t10_bombard","type":"bombard","actor":"rc10","target":[6,13],"title":"目标：清除旗点附近威胁","prompt":"使用大本营内的炮选择旗点附近轰炸中心。命中仍由固定种子决定。","success":"轰炸清除了旗点附近威胁。"},{"id":"t10_capture","type":"move","actor":"rp10","target":[6,13],"title":"目标：开始占领","prompt":"让合适的棋子抵达已发现旗点。","success":"红方正在夺旗（1/3）。"},{"id":"t10_hold","type":"observe","title":"守住旗点","prompt":"播放敌方固定行动，确认占领者仍在旗点。","button":"敌方行动","success":"红方正在夺旗（2/3）。"},{"id":"t10_finish","type":"observe","title":"完成综合考核","prompt":"再完成一个敌方行动窗口。","button":"敌方行动","success":"红方成功夺得目标旗；综合考核通过。"}])
summary = PackedStringArray("你独立建立了侦察视野", "你处理了隐藏路径接触", "你使用资源清除旗点威胁", "你维持占领并夺得第一面战旗")

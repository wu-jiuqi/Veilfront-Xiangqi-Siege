[gd_resource type="Resource" script_class="TutorialPresentationTrack" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/game/tutorial/tutorial_presentation_track.gd" id="1"]

[resource]
script = ExtResource("1")
track_id = "tutorial-t0-presentation-v1"
level_id = "T0"
title = "棋落交点"
subtitle = "操作校准"
goal = "完成选择取消、右键标注和一次带确认的普通移动。"
tags = PackedStringArray("交点棋盘", "右键取消", "本地标注", "行动确认")
steps = Array[Dictionary]([{"id":"t0_cancel","type":"cancel_selection","actor":"rp0","title":"先选择，再取消","prompt":"左键选择红兵，然后在棋盘上右键。选中状态的首次右键只能取消选择。","success":"已取消选择，没有打开标注菜单，也没有消耗行动。"},{"id":"t0_marker","type":"annotate","target":[4,5],"marker":"circle","title":"放置私人标记","prompt":"保持未选中状态，在（4,5）右键并选择圆形标记。","success":"圆形标记已放置。它只属于本地表现，不影响合法落点。"},{"id":"t0_move","type":"move","actor":"rp0","target":[5,5],"title":"确认普通移动","prompt":"选择红兵，再选择（5,5），最后点击棋盘下方变为“确认移动”的移动按钮。","success":"红兵完成普通移动；本章检查点已建立。"}])
summary = PackedStringArray("棋子落在点线交点", "选中时右键先取消", "未选中时右键才能标注", "预览必须确认后才提交")

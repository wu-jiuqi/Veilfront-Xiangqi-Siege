[gd_resource type="Resource" script_class="TutorialPresentationTrack" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/game/tutorial/tutorial_presentation_track.gd" id="1"]

[resource]
script = ExtResource("1")
track_id = "tutorial-t0-presentation-v1"
level_id = "T0"
title = "棋落交点"
subtitle = "操作校准"
goal = "完成选择取消、右键标注和一次带确认的普通移动。"
tags = PackedStringArray("交点棋盘", "右键取消", "本地标注", "行动确认")
steps = Array[Dictionary]([{"id":"t0_cancel","type":"cancel_selection","actor":"rp0","title":"先选择，再取消","prompt":"左键选择红兵，然后在棋盘上右键。选中状态的首次右键只能取消选择。","success":"已取消选择，没有打开标注菜单，也没有消耗行动。"},{"id":"t0_marker","type":"annotate","target":[4,5],"marker":"circle","title":"放置私人标记","prompt":"保持未选中状态，在（4,5）右键并选择圆形标记。","success":"圆形标记已放置。它只属于本地表现，不影响合法落点。"},{"id":"t0_move","type":"move","actor":"rp0","target":[5,5],"title":"确认普通移动","prompt":"选择红兵，再选择（5,5），最后点击棋盘下方变为“确认移动”的移动按钮。","success":"红兵完成普通移动；预览只有确认后才会提交。"},{"id":"t0_mirror","type":"quiz","title":"镜像只改变显示","prompt":"切换赤/玄镜像视角后，权威棋盘坐标和规则会怎样？","options":["坐标与规则保持不变","坐标会永久翻转","棋子行动规则也会互换"],"correct":0,"success":"镜像让当前一方朝向屏幕下方，但不改变权威坐标或规则。"},{"id":"t0_navigation","type":"quiz","title":"小地图负责导航","prompt":"屏外目标出现在小地图上时，应该在哪里确认行动？","options":["回到主棋盘选择与确认","直接点击小地图提交","小地图会自动替你行动"],"correct":0,"success":"小地图只消费本方已授权信息并帮助定位；所有行动仍在主棋盘确认。"},{"id":"t0_hidden_preview","type":"quiz","title":"预览不是免费侦察","prompt":"两个公开信息完全相同、只在隐藏棋子上不同的局面，合法点和拒绝提示应该怎样？","options":["保持一致，不能泄露隐藏差异","精确标出隐藏棋子位置","只对熟练路线泄露"],"correct":0,"success":"预览、高亮和错误只使用玩家可见信息，不能成为侦察工具。"},{"id":"t0_turn_rhythm","type":"quiz","title":"行动与完整轮","prompt":"双方各完成一次行动后，战局完成了什么？","options":["一个完整轮","两场对局","一次免费预览"],"correct":0,"success":"赤方先手；主动跳过、超时或无合法行动同样会推进公开战局状态。"},{"id":"t0_modes","type":"quiz","title":"认清当前 Demo 模式","prompt":"教学脚本对手是否代表通用 AI 人机模式？","options":["不是；教学、挑战、局域网是不同入口","是；所有脚本局都是完整 AI","是；挑战关等同自由人机"],"correct":0,"success":"首版 Demo 提供教学、固定挑战与局域网；教程脚本不承诺通用 AI 人机。"},{"id":"t0_round_limit","type":"quiz","title":"计时与轮上限来自战局","prompt":"教程是否应该把当前测试值写成正式固定轮上限？","options":["不应该；只读取公开战局配置并说明原则","应该固定写成 50 轮","应该隐藏当前行动方"],"correct":0,"success":"轮上限具体值尚未冻结；界面只显示战局公开配置，教程不写死临时数值。"}])
summary = PackedStringArray("棋子落在点线交点", "镜像与小地图只改变浏览方式", "右键取消与私人标注不影响规则", "预览必须确认后才提交", "预览和提示不能泄露隐藏信息", "教学、挑战和局域网是不同模式")

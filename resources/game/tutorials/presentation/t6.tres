[gd_resource type="Resource" script_class="TutorialPresentationTrack" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/game/tutorial/tutorial_presentation_track.gd" id="1"]

[resource]
script = ExtResource("1")
track_id = "tutorial-t6-presentation-v1"
level_id = "T6"
title = "以身换援"
subtitle = "士"
goal = "先取消一次献祭，再确认献祭并观察合资格复活。"
tags = PackedStringArray("九宫斜走", "献祭确认", "可取消", "复活候选池")
steps = Array[Dictionary]([{"id":"t6_move","type":"move","actor":"ra6","target":[5,2],"title":"九宫内斜走","prompt":"让红士从（4,1）斜走到（5,2）。","success":"士完成九宫内普通移动。"},{"id":"t6_cancel","type":"sacrifice_cancel","actor":"ra6","title":"打开后取消献祭","prompt":"点击“献祭复活”，查看候选说明，然后使用确认栏的取消。","button":"献祭复活","success":"献祭已取消，士仍在场，行动没有消耗。"},{"id":"t6_confirm","type":"sacrifice_confirm","actor":"ra6","title":"确认献祭复活","prompt":"再次点击“献祭复活”并确认。固定种子会从红车、红兵中选择一枚。","button":"再次献祭","success":"红士进入公开阵亡记录，合资格友军复活到红方大本营空点。"},{"id":"t6_quiz","type":"quiz","title":"候选池确认","prompt":"公开阵亡记录中的红士和红帅是否属于复活随机池？","options":["都属于","只有红士属于","都不属于"],"correct":2,"success":"正确：它们会被公开记录，但明确排除在复活随机池外。"}])
summary = PackedStringArray("士只能在九宫内斜走", "献祭必须确认且可在提交前取消", "士先阵亡，再随机复活合资格友军", "阵亡士与将帅不进入复活随机池")

; Engine configuration file.
; Edit with Godot 4.7.1 when possible; manual changes are kept minimal for GATE-1.

config_version=5

[application]

config/name="雾疆：九路烽棋 - 三关试玩版"
config/version="0.1.0-level-test"
run/main_scene="res://scenes/level_test/level_test_lab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

board_select={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventKey,"physical_keycode":4194309)]
}
board_cancel_or_marker={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventKey,"physical_keycode":4194305)]
}
board_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":32)]
}
board_pan_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
board_pan_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
board_pan_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
board_pan_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
board_zoom_in={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":4), Object(InputEventKey,"physical_keycode":43)]
}
board_zoom_out={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":5), Object(InputEventKey,"physical_keycode":45)]
}
tutorial_skip={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.031, 0.04, 1)
